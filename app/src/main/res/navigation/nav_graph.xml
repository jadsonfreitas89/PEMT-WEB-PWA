<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="br.com.jadson.appchecklistpemt.ui.screens.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_completeProfileFragment"
            app:destination="@id/completeProfileFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="br.com.jadson.appchecklistpemt.ui.screens.RegisterFragment"
        android:label="Cadastro"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_registerFragment_to_completeProfileFragment"
            app:destination="@id/completeProfileFragment" />
    </fragment>

    <fragment
        android:id="@+id/completeProfileFragment"
        android:name="br.com.jadson.appchecklistpemt.ui.screens.CompleteProfileFragment"
        android:label="Completar Perfil"
        tools:layout="@layout/fragment_complete_profile">
        <action
            android:id="@+id/action_completeProfileFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/completeProfileFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="br.com.jadson.appchecklistpemt.ui.screens.HomeFragment"
        android:label="Início"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_completeProfileFragment"
            app:destination="@id/completeProfileFragment" />
    </fragment>

    <fragment
        android:id="@+id/inspectionIntroFragment"
        android:name="br.com.jadson.appchecklistpemt.ui.screens.InspectionIntroFragment"
        android:label="Inspeção"
        tools:layout="@layout/fragment_inspection_intro" />

    <fragment
        android:id="@+id/safetyCommitmentFragment"
        android:name="br.com.jadson.appchecklistpemt.ui.screens.SafetyCommitmentFragment"
        android:label="Compromisso"
        tools:layout="@layout/fragment_safety_commitment" />

    <fragment
        android:id="@+id/checklistFragment"
        android:name="br.com.jadson.appchecklistpemt.ui.screens.ChecklistFragment"
        android:label="Novo Checklist"
        tools:layout="@layout/fragment_checklist">
        <argument
            android:name="checklistId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="br.com.jadson.appchecklistpemt.ui.screens.HistoryFragment"
        android:label="Histórico"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="br.com.jadson.appchecklistpemt.ui.screens.SettingsFragment"
        android:label="Configurações"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/listSimpleFragment"
        android:name="br.com.jadson.appchecklistpemt.ui.screens.ListSimpleFragment"
        android:label="Lista"
        tools:layout="@layout/fragment_list_simple">
        <argument
            android:name="type"
            app:argType="string" />
    </fragment>
</navigation>
